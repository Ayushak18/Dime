{
  "info": {
    "name": "Dime API",
    "description": "Endpoints for the Dime API (apps/api). Add a new request here whenever a new route is added.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "List Stocks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/stocks",
          "host": ["{{base_url}}"],
          "path": ["stocks"]
        }
      },
      "response": []
    }
  ]
}
